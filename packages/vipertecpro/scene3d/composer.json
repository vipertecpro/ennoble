{
    "name": "vipertecpro/scene3d",
    "description": "Real-time 3D for NativePHP Mobile \u2014 one Filament-backed renderer for iOS and Android, described from PHP.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Your Name",
            "email": "you@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Vipertecpro\\Scene3d\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vipertecpro\\Scene3d\\Scene3dServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "illuminate/view": "^13.24"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "keywords": [
        "nativephp",
        "3d",
        "filament",
        "gltf",
        "games",
        "mobile"
    ],
    "autoload-dev": {
        "psr-4": {
            "Vipertecpro\\Scene3d\\Tests\\": "tests/"
        }
    }
}
